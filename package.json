{
  "name": "@ekisu/mdxx",
  "version": "0.4.0",
  "description": "Render reproducible, interactive HTML from self-describing MDX documents",
  "license": "MIT",
  "module": "src/index.ts",
  "bin": {
    "mdxx": "src/index.ts"
  },
  "type": "module",
  "files": [
    "src",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ekisu/mdxx.git"
  },
  "bugs": {
    "url": "https://github.com/ekisu/mdxx/issues"
  },
  "homepage": "https://github.com/ekisu/mdxx#readme",
  "engines": {
    "bun": ">=1.3.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "check": "tsc --noEmit",
    "prepublishOnly": "bun run check && bun test"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.8.0",
    "happy-dom": "^20.11.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@babel/code-frame": "^8.0.0",
    "@babel/core": "^8.0.1",
    "@babel/parser": "^8.0.4",
    "@babel/plugin-transform-typescript": "^8.0.1",
    "@mdx-js/mdx": "^3.1.1",
    "@shikijs/rehype": "^4.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.0"
  }
}
